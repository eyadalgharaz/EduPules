// EduPules — Entity-Relationship Diagram (core entities)
// Source of truth: database/001_schema.sql. The Advisor role's profile is stored in table teaching_assistants.
// Render: dot -Tsvg erd.dot -o erd.svg   |   dot -Tpng -Gdpi=220 erd.dot -o erd.png
digraph ERD {
  graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.55, bgcolor="transparent", pad=0.1, fontname="Arial"];
  node  [shape=plain, fontname="Arial", fontsize=11];
  edge  [color="#64748B", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=10, fontcolor="#334155", dir=both, arrowtail=none];

  User [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#0F172A" align="left"><font color="#FFFFFF"><b> USER </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left">email (unique)</td></tr><tr><td align="left">hashed_password</td></tr><tr><td align="left">role (enum)</td></tr></table>>];
  Department [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#334155" align="left"><font color="#FFFFFF"><b> DEPARTMENT </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left">name, code</td></tr><tr><td align="left"><b>FK</b> head_professor_id</td></tr></table>>];
  Student [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#0E7C7B" align="left"><font color="#FFFFFF"><b> STUDENT </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> user_id, department_id</td></tr><tr><td align="left">student_number, year</td></tr><tr><td align="left">gpa (trigger-updated)</td></tr></table>>];
  Professor [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#0E7C7B" align="left"><font color="#FFFFFF"><b> PROFESSOR </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> user_id, department_id</td></tr><tr><td align="left">title, specialization</td></tr></table>>];
  Advisor [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#0E7C7B" align="left"><font color="#FFFFFF"><b> ADVISOR </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> user_id, department_id</td></tr><tr><td align="left"><b>FK</b> professor_id</td></tr></table>>];
  Course [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> COURSE </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left">code, name, credits</td></tr><tr><td align="left"><b>FK</b> professor_id, department_id</td></tr></table>>];
  Section [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> COURSE_SECTION </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> course_id</td></tr><tr><td align="left"><b>FK</b> advisor_id</td></tr></table>>];
  Enrollment [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> ENROLLMENT </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> student_id, course_id</td></tr><tr><td align="left">grade, status</td></tr></table>>];
  Attendance [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> ATTENDANCE </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> student_id, course_id</td></tr><tr><td align="left">date, status</td></tr></table>>];
  Quiz [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> QUIZ </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> course_id, created_by</td></tr><tr><td align="left">status, passing_score</td></tr></table>>];
  Submission [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#4F46E5" align="left"><font color="#FFFFFF"><b> QUIZ_SUBMISSION </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> quiz_id, student_id</td></tr><tr><td align="left">score, percentage</td></tr></table>>];
  Risk [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#E11D48" align="left"><font color="#FFFFFF"><b> RISK_ASSESSMENT </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> student_id</td></tr><tr><td align="left">risk_level, probability</td></tr><tr><td align="left">recommendations (JSONB)</td></tr></table>>];
  Plan [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#E11D48" align="left"><font color="#FFFFFF"><b> INTERVENTION_PLAN </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> student_id</td></tr><tr><td align="left">status, priority, deadline</td></tr></table>>];
  Action [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#E11D48" align="left"><font color="#FFFFFF"><b> INTERVENTION_ACTION </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> plan_id</td></tr><tr><td align="left">description, completed</td></tr></table>>];
  Notification [label=<<table cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#CBD5E1" border="1">
   <tr><td bgcolor="#334155" align="left"><font color="#FFFFFF"><b> NOTIFICATION </b></font></td></tr>
   <tr><td align="left"><b>PK</b> id</td></tr><tr><td align="left"><b>FK</b> user_id</td></tr><tr><td align="left">type, priority, read</td></tr></table>>];

  User -> Student    [taillabel="1", headlabel="0..1"];
  User -> Professor  [taillabel="1", headlabel="0..1"];
  User -> Advisor    [taillabel="1", headlabel="0..1"];
  User -> Notification [taillabel="1", headlabel="N"];
  Department -> Student [taillabel="1", headlabel="N"];
  Department -> Course  [taillabel="1", headlabel="N"];
  Professor -> Course   [taillabel="1", headlabel="N"];
  Professor -> Advisor  [taillabel="1", headlabel="N"];
  Course -> Section     [taillabel="1", headlabel="N"];
  Advisor -> Section    [taillabel="1", headlabel="N"];
  Student -> Enrollment [taillabel="1", headlabel="N"];
  Course -> Enrollment  [taillabel="1", headlabel="N"];
  Student -> Attendance [taillabel="1", headlabel="N"];
  Course -> Attendance  [taillabel="1", headlabel="N", constraint=false];
  Course -> Quiz        [taillabel="1", headlabel="N"];
  Quiz -> Submission    [taillabel="1", headlabel="N"];
  Student -> Submission [taillabel="1", headlabel="N"];
  Student -> Risk       [taillabel="1", headlabel="N"];
  Student -> Plan       [taillabel="1", headlabel="N"];
  Plan -> Action        [taillabel="1", headlabel="N"];
}
